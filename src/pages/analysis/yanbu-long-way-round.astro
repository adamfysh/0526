      <tr><td class="bold">Suez Canal transit to Port Said</td><td class="num">103</td><td class="num">0.3</td></tr>
      <tr><td class="bold">Port Said to Gibraltar</td><td class="num">1,916</td><td class="num">5.7</td></tr>
      <tr><td class="bold">Gibraltar to the Cape of Good Hope</td><td class="num">5,348</td><td class="num">15.9</td></tr>
      <tr><td class="bold">Cape of Good Hope to the northern Malacca approach</td><td class="num">4,993</td><td class="num">14.9</td></tr>
