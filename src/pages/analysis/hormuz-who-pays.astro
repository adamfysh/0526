      <tr><td class="bold">France</td><td class="num dep-low">11.8%</td><td class="num bold">$3.0B</td><td class="num bold">$0.2B</td><td><span class="verdict-ok">Atlantic alternatives close · SPR buffer · cost exposure not supply gap</span></td></tr>
      <tr><td class="bold">Germany</td><td class="num dep-low">7.7%</td><td class="num bold">$3.5B</td><td class="num bold">$0.3B</td><td><span class="verdict-ok">Low base dependency · SPR buffer · well covered</span></td></tr>
