      <tr><td class="bold">Japan</td><td class="num dep-high">79.1%</td><td class="num bold">$56.8B</td><td class="num bold">$4.7B</td><td><span class="verdict-caution">Cape viable · +12d · no supply substitute at scale</span></td></tr>
      <tr><td class="bold">South Korea</td><td class="num dep-high">63.9%</td><td class="num bold">$54.6B</td><td class="num bold">$4.5B</td><td><span class="verdict-caution">Cape viable · +12d · limited strategic reserve depth</span></td></tr>
      <tr><td class="bold">India</td><td class="num dep-high">42.3%</td><td class="num bold">$59.8B</td><td class="num bold">$4.9B</td><td><span class="verdict-caution">Cape viable · grade flexibility limited · volume large</span></td></tr>
      <tr><td class="bold">Greece</td><td class="num dep-mid">41.4%</td><td class="num bold">$5.7B</td><td class="num bold">$0.5B</td><td><span class="verdict-no">Grade-configured refiners · low substitution flexibility</span></td></tr>
