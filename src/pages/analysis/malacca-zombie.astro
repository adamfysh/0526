 <table class="n-table">
  <thead>
   <tr>
    <th>Corridor</th>
    <th class="num">Structural dependency</th>
    <th class="num">Annual VaR</th>
    <th>Bypass status</th>
   </tr>
  </thead>
  <tbody>
   <tr>
    <td class="bold">Strait of Malacca</td>
    <td class="num dep-mid">55.8%</td>
    <td class="num bold">$201.7B</td>
    <td><span class="verdict-caution">Lombok viable · +4 days · $268k/voyage</span></td>
   </tr>
   <tr>
    <td class="bold">Strait of Lombok</td>
    <td class="num dep-low">20.6%</td>
    <td class="num bold">$74.4B</td>
    <td><span class="verdict-caution">Malacca (reverse) or Sunda (partial draft limit)</span></td>
