---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
---

<ArticleLayout
  title="Blocked at one chokepoint, a grain fleet sailed <em>the long way east</em>, through four more chokepoints, then had to move again."
  description="When the 2023–24 drought priced US Gulf grain carriers out of the Panama auction, rounding South America was never really on the table. The fleet went the opposite direction instead, traded one chokepoint for a chain of four, then lost one of those to war risk and had to move again."
  eyebrow="Route Analysis &middot; Panama Canal Displacement &middot; Sept 2026"
  publishDate="Sept 2026"
  readTime="9 min read"
  author="Narrows Research"
  ogImage="/images/panama-long-way-around-og.png"
>

<div slot="stat-bar" class="stat-bar">
  <div class="stat-bar-inner">
    <div class="stat-bar-item">
      <div class="stat-bar-label">Panama, US Gulf to Shanghai</div>
      <div class="stat-bar-value">10,807 nm</div>
      <div class="stat-bar-unit">Baseline great-circle distance</div>
    </div>
    <div class="stat-bar-item">
      <div class="stat-bar-label">Cape Horn, the road not taken</div>
      <div class="stat-bar-value">+70%</div>
      <div class="stat-bar-unit">Farther than Panama; almost no vessel sailed it</div>
    </div>
    <div class="stat-bar-item">
      <div class="stat-bar-label">Suez / Red Sea corridor</div>
      <div class="stat-bar-value">4</div>
      <div class="stat-bar-unit">Chokepoints: Gibraltar, Suez, Bab-el-Mandeb, Malacca</div>
    </div>
    <div class="stat-bar-item">
      <div class="stat-bar-label">Peak Panama slot auction</div>
      <div class="stat-bar-value">$3.975M</div>
      <div class="stat-bar-unit">Documented record bid, November 2023</div>
    </div>
  </div>
</div>

<style>
*{box-sizing:border-box;}

  /* ---- map ---- */
  .map-panel{background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:20px 20px 14px; margin-bottom:8px;}
  .map-panel svg{width:100%; height:auto; display:block;}
  .land{fill:#B9C6D9; stroke:none;}
  .grat{fill:none; stroke:#C7D2E0; stroke-width:0.4; opacity:0.6;}

  .route{fill:none; stroke-linecap:round; stroke-linejoin:round;}
  .route-panama{stroke:var(--blue); stroke-width:2.6;}
  .route-horn{stroke:var(--text-tertiary); stroke-width:1.6; stroke-dasharray:1.5 5; opacity:0.85;}
  .route-suez{stroke:var(--gold-dark); stroke-width:2.6;}
  .route-good{stroke:var(--red); stroke-width:2.6; stroke-dasharray:7 4;}

  .node-city{fill:var(--navy);}
  .node-choke{fill:var(--white); stroke:var(--navy); stroke-width:1.6;}
  .map-label{font-family:var(--font-body); font-size:9.5px; fill:var(--text-secondary); font-weight:500;}
  .map-label-bold{font-family:var(--font); font-size:10px; fill:var(--navy); font-weight:700;}
  .map-label-tiny{font-family:var(--font-body); font-size:8px; fill:var(--text-tertiary); font-style:italic;}

  .map-legend{display:flex; flex-wrap:wrap; gap:16px 22px; padding:12px 6px 4px; font-family:var(--font-body); font-size:11.5px; color:var(--text-secondary);}
  .map-legend-item{display:flex; align-items:center; gap:7px;}
  .swatch{width:20px; height:0; border-top-width:3px; border-top-style:solid; display:inline-block;}

  /* ---- stat strip ---- */
  .stats{display:grid; grid-template-columns:repeat(4,1fr); gap:0; margin:22px 0 6px; border-top:1px solid var(--border);}
  .stat-col{padding:16px 14px 4px; border-right:1px solid var(--border);}
  .stat-col:last-child{border-right:none;}
  .stat-tag{display:inline-block; font-family:var(--font); font-weight:700; font-size:10px; letter-spacing:.04em; text-transform:uppercase; padding:2px 7px; border-radius:3px; margin-bottom:8px;}
  .tag-panama{background:var(--blue-pale); color:var(--blue);}
  .tag-horn{background:var(--surface); color:var(--text-tertiary); border:1px dashed var(--border);}
  .tag-suez{background:var(--gold-pale); color:var(--gold-dark);}
  .tag-good{background:var(--red-pale); color:var(--red);}
  .stat-name{font-family:var(--font); font-weight:700; font-size:13.5px; color:var(--navy); margin-bottom:8px; line-height:1.3;}
  .stat-row{display:flex; justify-content:space-between; align-items:baseline; font-family:var(--font-body); font-size:11.5px; color:var(--text-secondary); padding:4px 0; border-top:1px solid var(--border);}
  .stat-row span:last-child{font-family:var(--font-mono); font-weight:600; color:var(--text-primary); font-size:12px; text-align:right;}
  .stat-row-stack{flex-direction:column; align-items:flex-start; gap:3px;}
  .stat-row-stack span:last-child{text-align:left;}

  hr.rule{border:none; border-top:1px solid var(--border); margin:36px 0;}

  /* ---- side by side callouts ---- */
  .callouts{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:8px;}
  .callout-box{background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:18px 20px;}
  .callout-box.chokepoint-note{background:#F1EDF8; border-color:rgba(107,78,158,0.25);}
  .callout-eyebrow{font-family:var(--font); font-weight:700; font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-tertiary); margin-bottom:8px;}
  .chokepoint-note .callout-eyebrow{color:#6B4E9E;}
  .callout-title{font-family:var(--font); font-weight:700; font-size:14.5px; color:var(--navy); margin-bottom:8px; line-height:1.3;}
  .callout-text{font-family:var(--font-body); font-size:12.5px; line-height:1.55; color:var(--text-secondary);}
  .callout-text b{color:var(--text-primary); font-weight:600;}

  /* ---- today panel ---- */
  .today-panel{background:var(--navy); border-radius:10px; padding:24px 28px; color:var(--white); display:grid; grid-template-columns:1.1fr 1.4fr; gap:24px; align-items:center; margin-top:8px;}
  .today-eyebrow{font-family:var(--font); font-weight:700; font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); margin-bottom:8px;}
  .today-title{font-family:var(--font); font-weight:700; font-size:17px; line-height:1.3; margin-bottom:8px;}
  .today-body{font-family:var(--font-body); font-size:12px; line-height:1.55; color:rgba(255,255,255,0.72);}
  .today-figs{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .today-fig{background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:12px 14px;}
  .today-fig-lbl{font-family:var(--font-body); font-size:10px; color:rgba(255,255,255,0.55); margin-bottom:5px;}
  .today-fig-val{font-family:var(--font-mono); font-weight:600; font-size:17px; color:var(--white);}
  .today-range{grid-column:1/span 2; background:rgba(240,180,41,0.12); border:1px solid rgba(240,180,41,0.3); border-radius:8px; padding:12px 14px;}
  .today-range-lbl{font-family:var(--font-body); font-size:10px; color:rgba(255,255,255,0.6); margin-bottom:4px;}
  .today-range-val{font-family:var(--font-mono); font-weight:600; font-size:21px; color:var(--gold);}

  .source{font-family:var(--font-body); font-size:10.5px; line-height:1.55; color:var(--text-tertiary); margin-top:26px; max-width:960px;}


@media (max-width: 700px) {
  .stats{grid-template-columns:repeat(2,1fr);}
  .stat-col{border-bottom:1px solid var(--border); padding-bottom:14px; margin-bottom:6px;}
  .stat-col:nth-child(2n){border-right:none;}
  .callouts{grid-template-columns:1fr;}
  .today-panel{grid-template-columns:1fr;}
  .today-figs{grid-template-columns:1fr 1fr;}
  .stats-row{flex-direction:column;}
}
@media (max-width: 460px) {
  .stats{grid-template-columns:1fr;}
  .stat-col{border-right:none;}
}
</style>

