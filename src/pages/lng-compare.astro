---
import ArticleLayout from '../layouts/ArticleLayout.astro';
---

<ArticleLayout
  title="Gulf LNG: route tree vs. Sankey — which tells the story better?"
  description="Two ways to visualise $51.5B of annual Gulf LNG flows and the chokepoints every cargo must survive. We want your view."
  eyebrow="Interactive Analysis"
  publishDate="June 2026"
  author="Narrows Research"
>

<style>
  /* ── Lede ───────────────────────────────────────────────────────────────── */
  .lede {
    font-size: 16px; color: var(--text-secondary); line-height: 1.75;
    font-weight: 300; margin-bottom: 28px; max-width: 680px;
  }
  .lede strong { color: var(--text-primary); font-weight: 600; }

  /* ── Side-by-side chart grid ─────────────────────────────────────────────── */
  .charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0 0 40px;
  }
  .chart-col { display: flex; flex-direction: column; gap: 12px; }
  .chart-label {
    font-size: 9px; font-weight: 700; letter-spacing: 0.13em;
    text-transform: uppercase; color: var(--text-tertiary);
    display: flex; align-items: center; gap: 8px;
  }
  .chart-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--navy); color: #fff; font-size: 9px; font-weight: 700;
  }
  .chart-frame {
    width: 100%; border: none; border-radius: 8px;
    display: block; background: #0A2540; flex: 1;
  }
  .chart-caption {
    font-size: 12px; color: var(--text-tertiary); line-height: 1.55;
  }

  /* ── Vote ────────────────────────────────────────────────────────────────── */
  .vote-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 13px 20px; border-radius: 6px;
    font-size: 13px; font-weight: 700; cursor: pointer;
    font-family: inherit; border: none;
    transition: transform 0.12s, opacity 0.15s;
  }
  .vote-btn:hover:not([disabled]) { transform: translateY(-2px); }
  .vote-btn[disabled] { opacity: 0.4; cursor: default; transform: none; pointer-events: none; }
  .vote-btn-tree   { background: var(--gold); color: var(--navy); }
  .vote-btn-sankey { background: var(--navy); color: #fff; border: 1.5px solid rgba(255,255,255,0.15); }

  #vote-status {
    text-align: center; font-size: 14px; color: var(--text-secondary);
    padding: 10px 0; min-height: 20px;
  }
  #vote-status.sent { color: var(--gold); font-weight: 600; }

  /* ── Rule ────────────────────────────────────────────────────────────────── */
  hr.rule { border: none; border-top: 1px solid var(--rule-light, #e5e7eb); margin: 48px 0; }

  /* ── Background section ──────────────────────────────────────────────────── */
  .section-label {
    font-size: 9px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-tertiary);
    display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
  }
  .section-label::before {
    content: ''; display: block; width: 20px; height: 2px; background: var(--gold);
  }
  h2.section-title {
    font-size: clamp(19px, 2.5vw, 24px); font-weight: 700;
    color: var(--navy); letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 16px;
  }
  .prose {
    font-size: 15px; color: var(--text-secondary); line-height: 1.8;
    font-weight: 300; margin-bottom: 20px;
  }
  .prose strong { color: var(--text-primary); font-weight: 600; }

  /* ── Stat bar ────────────────────────────────────────────────────────────── */
  .stat-row {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: #e5e7eb; border: 1px solid #e5e7eb;
    border-radius: 6px; overflow: hidden; margin: 28px 0;
  }
  .stat-cell { background: #fff; padding: 16px 20px; }
  .stat-lbl  { font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px; }
  .stat-val  { font-size: 26px; font-weight: 700; color: var(--navy); letter-spacing: -0.02em; line-height: 1; }
  .stat-unit { font-size: 11px; color: var(--text-secondary); margin-top: 4px; font-weight: 300; }

  /* ── Callout ─────────────────────────────────────────────────────────────── */
  .callout {
    background: #f0f9ff; border-left: 3px solid var(--gold);
    border-radius: 0 6px 6px 0; padding: 16px 20px; margin: 24px 0;
  }
  .callout-label {
    font-size: 9px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--navy); margin-bottom: 6px;
  }
  .callout-body { font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
  .callout-body strong { color: var(--text-primary); font-weight: 600; }

  @media (max-width: 680px) {
    .charts-grid { grid-template-columns: 1fr; }
    .stat-row { grid-template-columns: 1fr 1fr; }
  }
</style>

<!-- ── Lede ───────────────────────────────────────────────────────────────── -->
<p class="lede">
  Every Gulf LNG cargo passes through <strong>Hormuz</strong>, then a further sequence of
  chokepoints before reaching its destination. We built two visualisations of the same data.
  Which one tells the story better?
</p>

<!-- ── Charts + vote ─────────────────────────────────────────────────────── -->
<div class="charts-grid">

  <!-- Route tree -->
  <div class="chart-col">
    <div class="chart-label"><span class="chart-num">1</span> Route Tree</div>
    <iframe id="frame-tree" class="chart-frame" src="/viz/qatar-route-tree.html"
      scrolling="no" title="Gulf LNG route tree" style="height:600px"></iframe>
    <p class="chart-caption">
      Geography and sequence. Line weight scales with trade value.
      Hover nodes for detail.
    </p>
    <button class="vote-btn vote-btn-tree" onclick="castVote('Route Tree')">
      Route Tree works better
    </button>
  </div>

  <!-- Sankey -->
  <div class="chart-col">
    <div class="chart-label"><span class="chart-num">2</span> Sankey</div>
    <iframe id="frame-sankey" class="chart-frame" src="/viz/gulf-lng-sankey.html"
      scrolling="no" title="Gulf LNG Sankey" style="height:600px"></iframe>
    <p class="chart-caption">
      Ribbon width proportional to dollar value. The full height of Hormuz = $51.5B.
      Hover ribbons for detail.
    </p>
    <button class="vote-btn vote-btn-sankey" onclick="castVote('Sankey')">
      Sankey works better
    </button>
  </div>

</div>

<div id="vote-status"></div>

<hr class="rule" />

<!-- ── Background ────────────────────────────────────────────────────────── -->
<div class="section-label">Background</div>
<h2 class="section-title">Why LNG chokepoints matter to risk and insurance</h2>

<p class="prose">
  Liquefied natural gas has become the critical swing fuel in the global energy system.
  Unlike pipeline gas, LNG can be redirected cargo by cargo to wherever the price is highest.
  This flexibility is commercially valuable, but it concentrates physical risk at a handful
  of maritime chokepoints that cannot be bypassed by laden tankers.
</p>

<p class="prose">
  A closure of <strong>Hormuz</strong> would strand every Gulf LNG cargo at source.
  <strong>Malacca</strong> controls onward delivery to China, Japan, South Korea, Taiwan,
  and Thailand: collectively the largest LNG import market in the world.
  <strong>Bab el-Mandeb</strong> (under active Houthi disruption since late 2023) and the
  <strong>Suez Canal</strong> together control the European route. Atlantic-facing terminals
  in Belgium, the UK, and the Netherlands add <strong>Gibraltar</strong> as a fifth
  sequential chokepoint.
</p>

<div class="callout">
  <div class="callout-label">Accumulation note</div>
  <div class="callout-body">
    These are <strong>sequential chokepoints</strong>, not alternatives. A cargo bound for
    Zeebrugge transits Hormuz, Bab, Suez, and Gibraltar before arriving. Disruption at any
    one cascades to the destination. This is the accumulation problem that conventional
    cargo models undercount.
  </div>
</div>

<div class="stat-row">
  <div class="stat-cell">
    <div class="stat-lbl">Annual Gulf LNG flow</div>
    <div class="stat-val">$51.5<span style="font-size:16px;font-weight:400">B</span></div>
    <div class="stat-unit">HS 271111 bilateral trade, all exporters</div>
  </div>
  <div class="stat-cell">
    <div class="stat-lbl">Mandatory Hormuz transit</div>
    <div class="stat-val">100<span style="font-size:16px;font-weight:400">%</span></div>
    <div class="stat-unit">No pipeline or bypass route exists</div>
  </div>
  <div class="stat-cell">
    <div class="stat-lbl">Pakistan Hormuz dependency</div>
    <div class="stat-val">98.2<span style="font-size:16px;font-weight:400">%</span></div>
    <div class="stat-unit">Highest of any importing nation globally</div>
  </div>
</div>

<p class="prose" style="font-size:13px; color:var(--text-tertiary);">
  Source: Narrows CDM v0.3, UN Comtrade HS 271111 bilateral trade flows.
  Dependency percentages reflect each country's share of total LNG imports
  originating in Hormuz-transit corridors.
</p>

</ArticleLayout>

<script is:inline>
  // ── iframe sizing ───────────────────────────────────────────────────────────
  // Fixed height 600px; expand if content is taller
  ['frame-tree', 'frame-sankey'].forEach(function(id) {
    var f = document.getElementById(id);
    if (!f) return;
    f.addEventListener('load', function () {
      try {
        var h = f.contentDocument.documentElement.scrollHeight;
        if (h > 200) f.style.height = h + 'px';
      } catch(e) {}
    });
  });

  // ── Vote via Web3Forms ──────────────────────────────────────────────────────
  var W3F_KEY = '7f12c345-c559-4e89-8347-d0910230ed22';
  var voted = false;

  async function castVote(choice) {
    if (voted) return;
    voted = true;
    document.querySelectorAll('.vote-btn').forEach(function(b) {
      b.setAttribute('disabled', true);
    });
    var status = document.getElementById('vote-status');
    status.textContent = 'Sending...';

    try {
      var res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          access_key: W3F_KEY,
          subject:    'LNG viz vote: ' + choice,
          from_name:  'Narrows vote page',
          vote:       choice,
          page:       window.location.href,
          botcheck:   ''
        })
      });
      var data = await res.json();
      if (data.success) {
        status.textContent = 'Vote recorded. Thank you.';
        status.classList.add('sent');
      } else {
        throw new Error(data.message);
      }
    } catch(err) {
      voted = false;
      status.textContent = 'Something went wrong. Please try again.';
      document.querySelectorAll('.vote-btn').forEach(function(b) {
        b.removeAttribute('disabled');
      });
    }
  }
</script>
