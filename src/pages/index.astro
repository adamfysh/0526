---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Narrows | Maritime Trade Risk Intelligence"
  description="Chokepoint exposure quantified by corridor, commodity, and vessel class. Built on the Chokepoint Dependency Model."
>

<style>
/* ─── HERO ─── */
.hero {
  background: var(--navy);
  border-bottom: 3px solid var(--gold);
  overflow: hidden;
  position: relative;
}
.hero-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 480px;
  align-items: center;
  min-height: 520px;
}
.hero-text {
  padding: 140px var(--s4) 96px;
}
.hero-image {
  position: relative;
  align-self: stretch;
  overflow: hidden;
}
.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 60% center;
  display: block;
  opacity: 0.82;
}
.hero-image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, var(--navy) 0%, transparent 28%, transparent 72%, var(--navy) 100%);
  pointer-events: none;
}
.hero-kicker {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: var(--s3);
  display: block;
}
.hero-headline {
  font-size: clamp(34px, 4.5vw, 58px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.07;
  letter-spacing: -0.03em;
  margin-bottom: var(--s3);
  max-width: 760px;
}
.hero-sub {
  font-size: 17px;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
  max-width: 560px;
  font-weight: 300;
  margin-bottom: var(--s5);
}

/* ─── CDM BAND ─── */
.cdm-band {
  border-bottom: var(--rule-light);
  padding: var(--s5) var(--s4);
}
.cdm-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--s5);
  align-items: start;
}
.cdm-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-tertiary);
  padding-top: 4px;
  line-height: 1.6;
}
.cdm-text {
  font-size: 16px;
  color: var(--text-secondary);
  line-height: 1.75;
  font-weight: 300;
  max-width: 680px;
}
.cdm-text strong {
  color: var(--text-primary);
  font-weight: 600;
}

/* ─── PRODUCTS ─── */
.products-section {
  padding: var(--s6) var(--s4);
  background: var(--surface);
  border-bottom: var(--rule-light);
}
.products-inner {
  max-width: var(--max-w);
  margin: 0 auto;
}
.products-header {
  margin-bottom: var(--s5);
}
.products-title {
  font-size: clamp(22px, 2.8vw, 32px);
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin-bottom: var(--s2);
}
.products-lead {
  font-size: 15px;
  color: var(--text-secondary);
  font-weight: 300;
  line-height: 1.7;
  max-width: 560px;
}
.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s2);
}
.product-card {
  background: var(--white);
  border: var(--rule-light);
  border-top: 3px solid var(--gold);
  border-radius: 0 0 6px 6px;
  padding: var(--s3);
  display: flex;
  flex-direction: column;
  gap: var(--s1);
  transition: box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
}
.product-card:hover {
  box-shadow: 0 8px 28px rgba(10,37,64,0.08);
  transform: translateY(-2px);
}
.product-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s2);
  margin-bottom: 4px;
}
.product-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.badge {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 3px;
  white-space: nowrap;
  flex-shrink: 0;
}
.badge-free {
  background: var(--green-pale);
  color: var(--green);
}
.badge-paid {
  background: var(--gold-pale);
  color: var(--gold-dark);
  border: 1px solid rgba(240,180,41,0.3);
}
.product-desc {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.65;
  font-weight: 300;
  flex: 1;
}
.product-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--blue);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: var(--s1);
  transition: gap 0.15s var(--ease), color 0.15s;
}
.product-link::after { content: '→'; }
.product-link:hover { color: var(--navy); gap: 8px; }
.product-link-note {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 300;
  font-style: italic;
  margin-top: 2px;
}

/* ─── PRI SECTION ─── */
.pri-section {
  padding: var(--s6) var(--s4);
  border-bottom: var(--rule-light);
}
.pri-inner { max-width: var(--max-w); margin: 0 auto; }
.pri-header { max-width: 680px; margin-bottom: var(--s5); }
.pri-title {
  font-size: clamp(26px, 3.2vw, 40px);
  font-weight: 700;
  color: var(--navy);
  line-height: 1.1;
  letter-spacing: -0.025em;
  margin-bottom: var(--s2);
}
.pri-title em { font-style: italic; font-weight: 400; color: var(--blue-light); }
.pri-lead {
  font-size: 15px;
  color: var(--text-secondary);
  line-height: 1.75;
  font-weight: 300;
}
.pri-preview {
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(10,37,64,0.1), 0 4px 16px rgba(10,37,64,0.06);
  border: var(--rule-light);
  margin-bottom: var(--s4);
  background: var(--white);
  cursor: pointer;
  transition: box-shadow 0.2s, transform 0.2s var(--ease);
}
.pri-preview:hover {
  box-shadow: 0 28px 80px rgba(10,37,64,0.14), 0 6px 24px rgba(10,37,64,0.08);
  transform: translateY(-2px);
}
.pri-chrome-topbar {
  background: var(--navy);
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.pri-chrome-dots { display: flex; gap: 5px; }
.pri-chrome-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.12); }
.pri-chrome-url { font-size: 10px; color: rgba(255,255,255,0.22); letter-spacing: 0.04em; font-family: 'SF Mono','Fira Code',monospace; }
.pri-search-bar {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 20px; border-bottom: var(--rule-light);
}
.pri-search-icon { font-size: 16px; color: var(--text-tertiary); }
.pri-search-text { font-size: 13px; color: var(--text-tertiary); font-weight: 300; }
.pri-search-hit { color: var(--navy); font-weight: 600; }
.pri-port-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 20px 10px; border-bottom: var(--rule-light);
}
.pri-port-name { font-size: 17px; font-weight: 700; color: var(--navy); letter-spacing: -0.01em; }
.pri-port-country { font-size: 13px; color: var(--text-tertiary); font-weight: 300; }
.pri-port-badge {
  display: flex; flex-direction: column; align-items: flex-end; gap: 2px;
  background: var(--navy); border-radius: 6px; padding: 10px 16px; flex-shrink: 0;
}
.pri-port-badge-label { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.4); white-space: nowrap; }
.pri-port-badge-score { font-size: 28px; font-weight: 700; letter-spacing: -0.03em; color: var(--gold); line-height: 1; }
.pri-dim-grid { display: grid; grid-template-columns: repeat(4,1fr); border-bottom: var(--rule-light); }
.pri-dim-card { padding: 16px 18px; border-right: var(--rule-light); }
.pri-dim-card:last-child { border-right: none; }
.pri-dim-label { font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 2px; }
.pri-dim-name { font-size: 11px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }
.pri-dim-score { font-size: 28px; font-weight: 700; color: var(--navy); letter-spacing: -0.03em; line-height: 1; margin-bottom: 8px; }
.pri-dim-score span { font-size: 12px; font-weight: 400; color: var(--text-tertiary); margin-left: 2px; }
.pri-dim-bar { height: 4px; background: rgba(10,37,64,0.07); border-radius: 2px; overflow: hidden; }
.pri-dim-fill { height: 100%; border-radius: 2px; }
.pri-table-wrap { position: relative; overflow: hidden; max-height: 180px; }
.pri-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.pri-table thead tr { background: var(--navy); }
.pri-table th { padding: 9px 14px; text-align: left; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.pri-table th:first-child { color: rgba(255,255,255,0.3); }
.pri-table th:nth-child(2), .pri-table th:nth-child(3) { color: rgba(255,255,255,0.5); }
.pri-table th:nth-child(4) { color: var(--gold); }
.pri-table th:nth-child(n+5) { color: rgba(255,255,255,0.35); }
.pri-table td { padding: 9px 14px; border-bottom: var(--rule-light); color: var(--text-secondary); }
.pri-table td:first-child { color: var(--text-tertiary); font-size: 11px; }
.pri-table td:nth-child(2) { color: var(--navy); font-weight: 600; }
.pri-table td:nth-child(4) { font-weight: 700; color: var(--navy); }
.pri-table tr:hover td { background: var(--blue-pale); }
.pri-blur-overlay {
  position: absolute; bottom: 0; left: 0; right: 0; height: 120px;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.85) 45%, rgba(255,255,255,0.98) 100%);
  display: flex; align-items: flex-end; justify-content: center; padding-bottom: 14px;
}
.pri-blur-msg { font-size: 11px; font-weight: 600; color: var(--blue); letter-spacing: 0.04em; }
.pri-open-cta { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
.pri-open-note { font-size: 12px; color: var(--text-tertiary); }

/* ─── ANALYSIS ─── */
.analysis-section {
  padding: var(--s6) var(--s4);
  background: var(--surface);
  border-bottom: var(--rule-light);
}
.analysis-inner { max-width: var(--max-w); margin: 0 auto; }
.analysis-header { margin-bottom: var(--s4); }
.analysis-title {
  font-size: clamp(22px, 2.6vw, 30px);
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin-bottom: var(--s1);
}
.analysis-sub {
  font-size: 14px;
  color: var(--text-secondary);
  font-weight: 300;
}
.analysis-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: var(--s3);
}
.analysis-card {
  background: var(--white);
  border: var(--rule-light);
  border-top: 3px solid var(--gold);
  border-radius: 0 0 6px 6px;
  padding: var(--s3);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s var(--ease), box-shadow 0.2s;
}
.analysis-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(10,37,64,0.08);
}
.analysis-card-tag {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 10px;
}
.analysis-card-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--navy);
  line-height: 1.3;
  letter-spacing: -0.01em;
  margin-bottom: 10px;
  flex: 1;
}
.analysis-card-body {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.65;
  font-weight: 300;
  margin-bottom: var(--s2);
}
.analysis-card-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--blue);
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: auto;
  transition: gap 0.15s var(--ease), color 0.15s;
}
.analysis-card-link::after { content: '→'; }
.analysis-card-link:hover { color: var(--navy); gap: 8px; }

/* ─── CTA ─── */
.cta-section {
  padding: var(--s6) var(--s4);
  background: var(--navy);
}
.cta-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--s6);
  align-items: center;
}
.cta-title {
  font-size: clamp(24px, 3vw, 38px);
  font-weight: 700;
  color: var(--white);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: var(--s2);
}
.cta-body {
  font-size: 15px;
  color: rgba(255,255,255,0.45);
  line-height: 1.7;
  font-weight: 300;
  max-width: 520px;
}
.cta-right {
  display: flex;
  flex-direction: column;
  gap: var(--s2);
  align-items: flex-start;
  min-width: 260px;
}
.cta-form { display: flex; flex-direction: column; gap: var(--s1); width: 100%; }
.cta-input {
  font-family: var(--font);
  font-size: 14px;
  font-weight: 400;
  color: var(--white);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 4px;
  padding: 12px 16px;
  width: 100%;
  outline: none;
  transition: border-color 0.15s, background 0.15s;
}
.cta-input::placeholder { color: rgba(255,255,255,0.25); }
.cta-input:focus { border-color: var(--gold); background: rgba(255,255,255,0.1); }
.cta-note { font-size: 11px; color: rgba(255,255,255,0.2); }

/* ─── RESPONSIVE ─── */
@media (max-width: 1000px) {
  .products-grid { grid-template-columns: repeat(2,1fr); }
  .cta-inner { grid-template-columns: 1fr; gap: var(--s4); }
  .cta-right { min-width: unset; width: 100%; max-width: 380px; }
}
@media (max-width: 800px) {
  .cdm-inner { grid-template-columns: 1fr; gap: var(--s2); }
  .products-grid { grid-template-columns: 1fr; }
  .analysis-grid { grid-template-columns: 1fr; }
  .pri-dim-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 1000px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-image { display: none; }
}
@media (max-width: 600px) {
  .hero-text { padding: 110px var(--s2) 64px; }
  .pri-section, .products-section, .analysis-section, .cta-section { padding: var(--s4) var(--s2); }
  .cdm-band { padding: var(--s4) var(--s2); }
}
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <span class="hero-kicker">The Narrows</span>
      <h1 class="hero-headline">Maritime trade risk intelligence.</h1>
      <p class="hero-sub">Chokepoint exposure quantified by corridor, commodity, and vessel class. Available before the disruption.</p>
      <a href="#briefing" class="btn btn-gold">Request a briefing</a>
    </div>
    <div class="hero-image">
      <img src="/images/suez-n.jpg" alt="Suez Canal — aerial view" loading="eager" />
    </div>
  </div>
</section>

<!-- CDM BAND -->
<div class="cdm-band">
  <div class="cdm-inner">
    <div class="cdm-label">Chokepoint Dependency Model</div>
    <p class="cdm-text">
      Every product in The Narrows is built on the <strong>Chokepoint Dependency Model</strong>.
      Bilateral trade data at commodity level, supplemented and validated with vessel, port, and market sources.
      The CDM is available directly to institutional and analytical clients.
    </p>
  </div>
</div>

<!-- PRODUCTS -->
<section class="products-section">
  <div class="products-inner">
    <div class="products-header fade-up">
      <h2 class="products-title">Risk intelligence products.</h2>
      <p class="products-lead">The Narrows products are connected and built on a common data foundation. Different clients will need some, all, or none of them.</p>
    </div>
    <div class="products-grid">

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">Port Risk Index</div>
          <span class="badge badge-free">Free</span>
        </div>
        <p class="product-desc">3,778 ports scored across four risk dimensions: accessibility, reliability, trade concentration, and political stability. The entry point to The Narrows data layer.</p>
        <a href="/pri" class="product-link">Open the Port Risk Index</a>
      </div>

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">Analysis</div>
          <span class="badge badge-free">Free</span>
        </div>
        <p class="product-desc">Corridor and scenario analysis demonstrating the method against live events. Published outputs proving the model and quantifying disruption.</p>
        <a href="/analysis" class="product-link">Read the analysis</a>
      </div>

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">Chokepoint Dependency Model</div>
          <span class="badge badge-paid">Paid</span>
        </div>
        <p class="product-desc">Bilateral trade dependency at commodity level across the world's principal maritime corridors. The data foundation. Available to institutional and analytical clients.</p>
        <a href="mailto:fysh@narrows.io?subject=CDM access enquiry" class="product-link">Enquire</a>
      </div>

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">CAPE</div>
          <span class="badge badge-paid">Paid</span>
        </div>
        <p class="product-desc">The CDM applied to a specific cargo portfolio. Locked positions, divertible positions, and rerouting cost by vessel class. A demonstration version is available.</p>
        <a href="/cape" class="product-link">View demonstration</a>
        <span class="product-link-note">Full version runs against a live portfolio.</span>
      </div>

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">CASCADE</div>
          <span class="badge badge-paid">Paid</span>
        </div>
        <p class="product-desc">Decision-support for live events. Committed fleet positions, decision windows, diversion cost and timeline by vessel. Built for the desk managing a closure in real time.</p>
        <a href="/cascade" class="product-link">View demonstration</a>
      </div>

      <div class="product-card fade-up">
        <div class="product-card-top">
          <div class="product-name">Bespoke Analysis</div>
          <span class="badge badge-paid">Paid</span>
        </div>
        <p class="product-desc">The Narrows methodology applied to a specific event, portfolio, or research question. Commissioned scenario and corridor analysis delivered as a report.</p>
        <a href="mailto:fysh@narrows.io?subject=Bespoke analysis enquiry" class="product-link">Enquire</a>
      </div>

    </div>
  </div>
</section>

<!-- PRI PREVIEW -->
<section class="pri-section">
  <div class="pri-inner">
    <div class="pri-header fade-up">
      <h2 class="pri-title">3,778 ports scored.<br><em>Across four dimensions of risk.</em></h2>
      <p class="pri-lead">The Narrows Port Risk Index applies an INFORM-style composite methodology to every major port in the World Port Index. Physical accessibility, operational reliability, trade concentration, and political stability: each scored, each decomposable, one composite number per port.</p>
    </div>

    <div class="pri-preview fade-up" onclick="window.location='/pri'" role="link" tabindex="0" aria-label="Open Port Risk Index">
      <div class="pri-chrome-topbar">
        <div class="pri-chrome-dots">
          <div class="pri-chrome-dot"></div>
          <div class="pri-chrome-dot"></div>
          <div class="pri-chrome-dot"></div>
        </div>
        <span class="pri-chrome-url">narrows.io/pri · Port Risk Index · 3,778 ports</span>
      </div>
      <div class="pri-search-bar">
        <span class="pri-search-icon">⌕</span>
        <span class="pri-search-text"><span class="pri-search-hit">Durban</span>, South Africa · Rank #1,885 of 3,778</span>
      </div>
      <div class="pri-port-header">
        <div>
          <div class="pri-port-name">Durban</div>
          <div class="pri-port-country">South Africa · Data tier A · All four dimensions scored</div>
        </div>
        <div class="pri-port-badge">
          <span class="pri-port-badge-label">Narrows Port Risk Index</span>
          <span class="pri-port-badge-score">1.52</span>
        </div>
      </div>
      <div class="pri-dim-grid">
        <div class="pri-dim-card">
          <div class="pri-dim-label">Dimension 1</div>
          <div class="pri-dim-name">Accessibility</div>
          <div class="pri-dim-score">0.52<span>/ 10</span></div>
          <div class="pri-dim-bar"><div class="pri-dim-fill" style="width:5.2%;background:#378ADD"></div></div>
        </div>
        <div class="pri-dim-card">
          <div class="pri-dim-label">Dimension 2</div>
          <div class="pri-dim-name">Reliability</div>
          <div class="pri-dim-score">4.33<span>/ 10</span></div>
          <div class="pri-dim-bar"><div class="pri-dim-fill" style="width:43.3%;background:#EF9F27"></div></div>
        </div>
        <div class="pri-dim-card">
          <div class="pri-dim-label">Dimension 3</div>
          <div class="pri-dim-name">Concentration</div>
          <div class="pri-dim-score">3.38<span>/ 10</span></div>
          <div class="pri-dim-bar"><div class="pri-dim-fill" style="width:33.8%;background:#7F77DD"></div></div>
        </div>
