      <p class="cta-body">The Narrows runs scenarios in front of the client, with the client's assumptions, on the corridor of interest. A person will respond.</p>
    </div>
    <div class="cta-right">
      <div class="cta-form">
        <input type="text" id="demo-honey" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;pointer-events:none" />
        <input type="email" class="cta-input" placeholder="your@organisation.com" id="demo-email" autocomplete="email" />
        <button class="btn btn-gold" id="demo-btn" style="width:100%">Send</button>
      </div>
      <span class="cta-note">fysh@narrows.io · A person will reply.</span>
    </div>
  </div>
</section>
)}

{COMMERCIAL && (
<script is:inline>
function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]{2,}\.[^\s@]{2,}$/.test(email);
}
function handleRequest() {
  var input = document.getElementById('demo-email');
  var honey = document.getElementById('demo-honey');
  var email = input.value.trim();
  if (honey && honey.value) return;
  if (!isValidEmail(email)) {
    input.style.borderColor = 'rgba(192,57,43,0.8)';
    setTimeout(function () { input.style.borderColor = ''; }, 2000);
    return;
  }
  window.location.href = 'mailto:fysh@narrows.io?subject=Briefing request: The Narrows&body=From: ' + email + '%0A%0AOrganisation:%0ARole:%0AProduct interest:%0A%0AContext (optional):';
}
var btn = document.getElementById('demo-btn');
if (btn) btn.addEventListener('click', handleRequest);
var em = document.getElementById('demo-email');
if (em) em.addEventListener('keydown', function (e) { if (e.key === 'Enter') handleRequest(); });
</script>
)}

